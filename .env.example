# Host from the `host` server variable in spec/openapi.yaml:
#   free-dashboard.kartina.tv (default, production)
#   free-dashboard-dev.kartina.tv
#   localhost
API_HOST=free-dashboard.kartina.tv

# Known-good fixture data used by tests that need a real page slug.
# `dashboard` and `details` exist in every installation per the API description.
FIXTURE_PAGE_SLUG=dashboard

# Web client the Free API backs — used by the browser-ui project (ui-tests/).
# Not the same host as the API's own `API_HOST` above. `playtest` (not `play`)
# is the test/staging host, same pattern as free-dashboard-dev.kartina.tv.
UI_BASE_URL=https://playtest.kartina.tv
